# ──────────────────────────────────────────────────────────────────────────
# AURIX Social AI — environment configuration
# Copy to .env for local development. Never commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Set to "true" to run the whole app (Instagram, image generation, analytics
# sync) against mock providers instead of live external APIs. Defaults to
# true in development so the product works with zero external credentials.
MOCK_MODE=true

# Auth — random 32+ byte secret used to sign session tokens (openssl rand -hex 32)
AUTH_SECRET=

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://aurix:aurix_dev_password@localhost:5432/aurix_social_ai"

# Security — 32-byte (base64) key used to encrypt integration credentials at rest
# (openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=

# AI — which reasoning provider lib/ai/provider-registry.ts hands back. "claude" needs
# ANTHROPIC_API_KEY; "gemini" needs GOOGLE_API_KEY (free tier available for Flash models via
# Google AI Studio: aistudio.google.com/apikey). Only one provider is active at a time.
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
AI_MODEL_STRATEGY=claude-opus-4-5
AI_MODEL_CONTENT=claude-sonnet-4-5
AI_MODEL_FAST=claude-haiku-4-5

GOOGLE_API_KEY=
GEMINI_MODEL_STRATEGY=gemini-2.5-flash
GEMINI_MODEL_CONTENT=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash

# Image generation provider — abstracted behind lib/ai/image-provider.ts.
# Leave unset to fall back to the mock image provider.
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=

# n8n — automation/orchestration layer
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Shared secret n8n must send back to AURIX webhook endpoints (Authorization: Bearer <token>)
AURIX_WEBHOOK_SECRET=

# Instagram / Meta Graph API (see docs/INSTAGRAM.md). Leave blank to stay in
# mock mode — the product remains fully usable without these.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/instagram/callback

# Object storage abstraction (lib/storage). Leave unset to use local disk
# storage under .data/uploads for development.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_PUBLIC_URL=

# Logging
LOG_LEVEL=info

# AI quality gate — content scoring at/above this is routed to human approval instead of
# "needs edit". Human approval is always required to publish regardless of this value.
AI_QUALITY_THRESHOLD=85
